	bool uart_emit(void * /*user_ref*/, size_t data_size, const uint8_t *data)
	{
		HAL_StatusTypeDef status = HAL_UART_Transmit(&huart2, data, data_size, 1000);
		return status == HAL_OK;
	}

	bool uart_accumulate(void *user_reference, uint8_t data_size, const uint8_t *data)
	{
		static MessageAccumulator<255> accumulator(user_reference, uart_emit);

		for (uint8_t i = 0; i < data_size; i++)
		{
			accumulator.process(data[i]);
		}
		return true;
	}

